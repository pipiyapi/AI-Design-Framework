#!/bin/sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
NODE_BIN=${NODE_BIN:-}

if [ -z "$NODE_BIN" ]; then
  if command -v node >/dev/null 2>&1; then
    NODE_BIN=$(command -v node)
  else
    NODE_BIN="/Users/hejuntao/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/bin/node"
  fi
fi

COMMAND=${1:-help}
if [ "$#" -gt 0 ]; then shift; fi

case "$COMMAND" in
  start)
    exec "$NODE_BIN" "$ROOT_DIR/review-app/server.mjs" "$@"
    ;;
  ingest)
    exec "$NODE_BIN" "$ROOT_DIR/scripts/ingest.mjs" "$@"
    ;;
  catalog)
    exec "$NODE_BIN" "$ROOT_DIR/scripts/build-catalog.mjs" "$@"
    ;;
  build)
    exec "$NODE_BIN" "$ROOT_DIR/scripts/build-skill.mjs" "$@"
    ;;
  pattern)
    exec "$NODE_BIN" "$ROOT_DIR/scripts/create-pattern-candidate.mjs" "$@"
    ;;
  import-feedback)
    exec "$NODE_BIN" "$ROOT_DIR/scripts/import-feedback.mjs" "$@"
    ;;
  test)
    cd "$ROOT_DIR"
    exec "$NODE_BIN" --test tests/*.test.mjs
    ;;
  *)
    echo "Personal Design Memory V1"
    echo ""
    echo "Commands:"
    echo "  start"
    echo "  ingest --url|--image|--video|--github <value>"
    echo "  catalog"
    echo "  build"
    echo "  pattern --title <name> --references <id,id> --rule <text>"
    echo "  import-feedback <project-directory>"
    echo "  test"
    ;;
esac
